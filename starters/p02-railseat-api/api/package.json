{
  "name": "railseat-api",
  "version": "1.0.0",
  "description": "RailSeat API: search trains and book seats, with no double booking.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "seed": "node seed/loadSeed.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.38",
      "preferGlobalPath": true
    }
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "mongoose": "^9.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "mongodb-memory-server": "^11.4.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
